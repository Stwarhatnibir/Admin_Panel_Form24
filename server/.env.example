# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the admin panel's
# own frontend URL). Example: http://localhost:5173,https://admin.example.com
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# ----------------------------------------------------------------------------
# Firebase Admin SDK
# Generate a service account key from Firebase Console > Project Settings >
# Service Accounts, and populate these values. Never commit the real values.
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# When pasting a private key into a .env file, keep the \n escape sequences;
# the app converts them back to real newlines at startup.
FIREBASE_PRIVATE_KEY=

FIREBASE_STORAGE_BUCKET=

# ----------------------------------------------------------------------------
# Firebase Cloud Messaging
# Uses the same service account as above; this project ID is kept separate
# in case FCM is ever routed through a different Firebase project.
# ----------------------------------------------------------------------------
FCM_PROJECT_ID=

# ----------------------------------------------------------------------------
# Payment gateway
# Provider has not been finalized. Leave as "mock" for local development.
# When a real provider is selected, implement server/services/payment/<provider>Provider.js
# and set PAYMENT_PROVIDER accordingly - no other code should need to change.
# ----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ----------------------------------------------------------------------------
# Seed script (development only)
# ----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
